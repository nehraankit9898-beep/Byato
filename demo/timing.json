  "cues": [
    {
      "start": 1.46,
      "end": 8.46,
      "text": "Meet Byato — a unified platform designed to simplify hotel and restaurant management."
    },
    {
      "start": 11.74,
      "end": 22.24,
      "text": "Manage your hospitality operations through one centralized workspace, with visibility into the features available to your role."
    },
    {
      "start": 26.32,
      "end": 35.82,
      "text": "Platform administrators can manage authorized platform-level settings, while access controls help protect sensitive operations."
    },
    {
      "start": 48.66,
      "end": 58.16,
      "text": "Hotel and restaurant teams can work within their authorized areas, keeping their operational data separate from other businesses."
    },
    {
      "start": 70.87,
      "end": 84.37,
      "text": "Role-based access control is enforced on the server for every request. Platform settings stay with platform administrators, pricing changes stay with managers, and one business can never read another business's customer records."
    },
    {
      "start": 96.61,
      "end": 105.61,
      "text": "Byato's access-control design aims to keep customer information private and limit access to authorized users."
    },
    {
      "start": 105.06,
      "end": 112.56,
      "text": "Byato — bringing hospitality operations together with clarity, control, and a focus on security."
    }
  ],
